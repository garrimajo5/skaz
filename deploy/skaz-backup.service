[Unit]
Description=SKAZ consistent SQLite backup
After=skaz.service

[Service]
Type=oneshot
User=skaz
Group=skaz
WorkingDirectory=/opt/skaz/current
EnvironmentFile=/etc/skaz.env
Environment=SKAZ_BACKUP_DIR=/var/backups/skaz
ExecStart=/opt/skaz-node/bin/node scripts/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skaz /var/backups/skaz
UMask=0077
