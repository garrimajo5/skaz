# OPTIONAL: include inside the existing authenticated HTTPS server block only.
# Does not enable personal-art capability. Keep server-wide 512k unchanged.
# Exact locations inherit Basic auth, TLS, and security headers from that server.
location = /api/personal-art/change {
    client_max_body_size 6m;
    limit_req zone=skaz_requests burst=30 nodelay;
    proxy_pass http://127.0.0.1:4173;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:4173;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}
location = /api/personal-art/import {
    client_max_body_size 46m;
    limit_req zone=skaz_requests burst=30 nodelay;
    proxy_pass http://127.0.0.1:4173;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:4173;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}
location = /api/import/game-with-art {
    # 64 MiB package plus the bounded command envelope (4096 bytes).
    client_max_body_size 67112960;
    limit_req zone=skaz_requests burst=30 nodelay;
    proxy_pass http://127.0.0.1:4173;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:4173;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}