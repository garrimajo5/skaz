# Include only inside the existing HTTPS server with inherited Basic Auth.
location = /api/import/campaign-memory {
    # 8 MiB package plus the bounded application envelope (4096 bytes).
    client_max_body_size 8392704;
    limit_req zone=skaz_requests burst=30 nodelay;
    proxy_pass http://127.0.0.1:4173;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:4173;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}
