[Unit]
Description=SKAZ private D&D companion
After=network.target

[Service]
Type=simple
User=skaz
Group=skaz
WorkingDirectory=/opt/skaz/current
EnvironmentFile=/etc/skaz.env
ExecStart=/opt/skaz-node/bin/node server/index.mjs
# The root serves the sign-in page without a session in individual mode.
# /api/health itself requires a personal session in that mode.
ExecStartPost=/usr/bin/curl --retry 10 --retry-connrefused --retry-delay 1 --fail --silent --show-error --output /dev/null http://127.0.0.1:4173/
TimeoutStartSec=30
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/skaz
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
