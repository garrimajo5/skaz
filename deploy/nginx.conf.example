# Substitute __PUBLIC_HOST__ with the exact IP or domain before installing.
limit_req_zone $binary_remote_addr zone=skaz_requests:10m rate=10r/s;
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __PUBLIC_HOST__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/skaz-acme; }
    location / { return 308 https://__PUBLIC_HOST__$request_uri; }
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/letsencrypt/live/skaz-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skaz-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 512k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    auth_basic "SKAZ private";
    auth_basic_user_file /etc/nginx/skaz.htpasswd;
    # Keep a rejected form login from evicting the independent Basic login.
    # In shared mode this endpoint is absent (404); other API 401s are unchanged.
    location = /api/auth/login {
        limit_req zone=skaz_requests burst=30 nodelay;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host 127.0.0.1:4173;
        proxy_set_header Authorization "";
        proxy_intercept_errors on;
        error_page 401 = @skaz_login_denied;
    }
    location @skaz_login_denied {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 403 '{"error":"Неверный логин или пароль"}';
    }
    location / {
        limit_req zone=skaz_requests burst=30 nodelay;
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:4173;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
