# Isolated synthetic fixture ONLY. This file is not installed by deployment.
# Default binding is loopback: it does not open a public test service.
# Substitute __PUBLIC_HOST__ with the existing certificate's exact IP/domain.
# Uses a separate upstream and database; leave the working 443 server unchanged.
server {
    listen 127.0.0.1:8443 ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/letsencrypt/live/skaz-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skaz-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 512k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    auth_basic "SKAZ synthetic check";
    auth_basic_user_file /etc/nginx/skaz.htpasswd;
    location / {
        limit_req zone=skaz_requests burst=30 nodelay;
        proxy_pass http://127.0.0.1:4177;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:4177;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
