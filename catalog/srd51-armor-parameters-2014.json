  "conditions": {
    "proficiency": {
      "sourcePage": 62,
      "textRu": "Доспех или щит можно надеть и без владения. По обычному правилу отсутствие владения надетым доспехом даёт помеху проверкам характеристик, спасброскам и броскам атаки с Силой или Ловкостью; накладывать заклинания нельзя. В СКАЗ это предупреждение с ручным исключением, а не запрет сохранения. Применение перечисленных последствий именно к щиту здесь не решается: источник упоминает щит во вводной, но в последствиях говорит о доспехе. До отдельного решения не переносить это условие на щит автоматически.",
      "affectedAbilities": [
        "strength",
        "dexterity"
      ],
      "affectedRolls": [
        "ability-check",
        "saving-throw",
        "attack-roll"
      ],
      "spellcastingAllowedByOrdinaryRule": false,
      "shieldConsequenceScope": "not-resolved-by-this-proposal",
      "shieldAutomation": false
    },
    "heavyArmorSpeed": {
      "sourcePage": 63,
      "penaltyFeet": 10,
      "trigger": "strength-below-listed-score",
      "isEquipRequirement": false,
      "textRu": "Сила ниже указанной в строке снижает скорость на 10 футов, а не запрещает носить доспех. Отсутствие значения не означает требования Силы. Особенности персонажа и личные исключения проверяются отдельно."
    },
    "shield": {
      "sourcePage": 63,
      "acBonus": 2,
      "hands": 1,
      "maximumBeneficialShields": 1,
      "textRu": "Щит занимает одну руку и даёт +2 КД. Одновременно учитывается польза только одного щита."
    },
    "donDoff": {
      "sourcePage": 64,
      "fullDonTimeRequiredForArmorAc": true,
      "assistedDoffMultiplier": 0.5,
      "assistedDonMultiplier": null,
      "textRu": "Польза КД доспеха появляется после полного надевания. Помощь уменьшает вдвое время снятия; уменьшение времени надевания здесь не установлено."
    },
    "dexterity": {
      "sourcePage": 63,
      "textRu": "Лёгкий доспех учитывает весь модификатор Ловкости. Средний ограничивает только верхнюю границу до +2: отрицательный модификатор сохраняется. Тяжёлый не учитывает ни положительный, ни отрицательный модификатор."
    }
  },
