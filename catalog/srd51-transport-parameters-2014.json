  "rules": [
    {
      "id": "hauling",
      "sourcePage": 71,
      "summaryRu": "Животное, тянущее карету, телегу, колесницу, сани или повозку, перемещает до пятикратной базовой грузоподъёмности. В этот вес входит сам транспорт. Для нескольких животных, тянущих один транспорт, базовые грузоподъёмности складываются.",
      "parameters": {
        "baseCapacityMultiplier": 5,
        "vehicleWeightIncluded": true,
        "combineAnimals": "sum-base-capacities"
      }
    },
    {
      "id": "unusual-mounts",
      "sourcePage": 71,
      "summaryRu": "Летающие и водные скакуны существуют, но редки и обычно не продаются. Их получение может потребовать выращивания, сделки или переговоров; цены здесь не установлены."
    },
    {
      "id": "barding",
      "sourcePage": 71,
      "summaryRu": "Доспех для животного стоит вчетверо дороже аналогичного доспеха для гуманоида и весит вдвое больше.",
      "parameters": {
        "costMultiplier": 4,
        "weightMultiplier": 2
      }
    },
    {
      "id": "military-saddle",
      "sourcePage": 71,
      "summaryRu": "Военное седло даёт преимущество на проверки, позволяющие оставаться верхом. Это не общее преимущество на атаки и проверки всадника."
    },
    {
      "id": "exotic-saddle",
      "sourcePage": 71,
      "summaryRu": "По обычному правилу для водного или летающего скакуна требуется экзотическое седло. В приложении отклонение должно предупреждать, сохраняя ручной путь."
    },
    {
      "id": "vehicle-proficiency",
      "sourcePage": 71,
      "summaryRu": "Владение соответствующим видом транспорта — наземным или водным — добавляет бонус мастерства к проверкам управления им в сложных обстоятельствах."
    },
    {
      "id": "rowed-vessels",
      "sourcePage": 71,
      "summaryRu": "Килевые и гребные лодки используются на озёрах и реках. При движении вниз по течению его скорость добавляется к скорости лодки; типичный пример — 3 мили в час, не обязательная константа. Против значительного течения они не идут на вёслах, но их могут тянуть животные с берега. Гребная лодка весит 100 фунтов.",
      "parameters": {
        "typicalCurrentSpeedMph": 3,
        "currentSpeedIsExample": true,
        "rowboatWeightLb": 100
      }
    }
  ]
}
